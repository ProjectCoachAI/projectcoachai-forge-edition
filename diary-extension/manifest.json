{
  "manifest_version": 3,
  "name": "Forge Diary",
  "short_name": "Diary",
  "version": "1.0.0",
  "description": "Save any AI response in one click. One place, organised automatically, stored for life.",
  "permissions": [
    "activeTab",
    "storage",
    "scripting",
    "alarms",
    "management",
    "webNavigation",
    "webRequest"
  ],
  "host_permissions": [
    "https://claude.ai/*",
    "https://chatgpt.com/*",
    "https://gemini.google.com/*",
    "https://www.perplexity.ai/*",
    "https://grok.com/*",
    "https://chat.deepseek.com/*",
    "https://chat.mistral.ai/*",
    "https://www.meta.ai/*",
    "https://api.projectcoachai.com/*",
    "https://diary.projectcoachai.com/*",
    "https://*.googleapis.com/*",
    "https://*.google.com/*",
    "https://*.perplexity.ai/*",
    "https://*.mistral.ai/*",
    "https://*.deepseek.com/*",
    "https://*.meta.ai/*",
    "https://*.grok.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://claude.ai/*",
        "https://chatgpt.com/*",
        "https://gemini.google.com/*",
        "https://www.perplexity.ai/*",
        "https://grok.com/*",
        "https://chat.deepseek.com/*",
        "https://chat.mistral.ai/*",
        "https://www.meta.ai/*"
      ],
      "js": [
        "diary-interceptor.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://claude.ai/*",
        "https://chatgpt.com/*",
        "https://gemini.google.com/*",
        "https://www.perplexity.ai/*",
        "https://grok.com/*",
        "https://chat.deepseek.com/*",
        "https://chat.mistral.ai/*",
        "https://www.meta.ai/*"
      ],
      "js": [
        "diary-isolated.js"
      ],
      "run_at": "document_start",
      "world": "ISOLATED"
    },
    {
      "matches": [
        "https://claude.ai/*",
        "https://chatgpt.com/*",
        "https://gemini.google.com/*",
        "https://www.perplexity.ai/*",
        "https://grok.com/*",
        "https://chat.deepseek.com/*",
        "https://chat.mistral.ai/*",
        "https://www.meta.ai/*"
      ],
      "js": [
        "lib/turndown.js",
        "lib/turndown-plugin-gfm.js",
        "diary-content.js"
      ],
      "run_at": "document_idle",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://claude.ai/*",
        "https://chatgpt.com/*",
        "https://gemini.google.com/*",
        "https://www.perplexity.ai/*",
        "https://grok.com/*",
        "https://chat.deepseek.com/*",
        "https://chat.mistral.ai/*",
        "https://www.meta.ai/*"
      ],
      "js": [
        "diary-dock.js"
      ],
      "run_at": "document_idle",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://diary.projectcoachai.com/*"
      ],
      "js": [
        "diary-isolated.js"
      ],
      "run_at": "document_start",
      "world": "ISOLATED"
    },
    {
      "matches": [
        "https://diary.projectcoachai.com/*"
      ],
      "js": [
        "diary-token-relay.js"
      ],
      "run_at": "document_idle",
      "world": "ISOLATED"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "externally_connectable": {
    "matches": [
      "https://diary.projectcoachai.com/*"
    ],
    "ids": [
      "momenmcgdmceejapigodolpekonmaedd"
    ]
  }
}